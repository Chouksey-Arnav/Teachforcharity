# ── Supabase (Project Settings → API) ─────────────────────────────────────────
# These two are public by design (they ship to the browser). Row-level security
# in the database is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://nkpdiglnyqgblqcqvbdp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ccii317AbhJ8WyokT9V5Cg_S8_khA3N

# SECRET. Server-only. Used by the email worker, the safety scanner, sign-up,
# and the /admin console. Never expose it to the browser.
# Supabase → Project Settings → API Keys → "service_role" / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# The public URL of the site (no trailing slash). Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in the footer and legal pages as the program's contact address.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Which email backend sends app emails ───────────────────────────────────────
# "smtp" = Nodemailer over any SMTP server (used for testing, e.g. Gmail).
# "brevo" (default when unset) = Brevo HTTP API. Switching is just this variable.
EMAIL_PROVIDER=smtp

# ── SMTP / Nodemailer (only read when EMAIL_PROVIDER=smtp) ─────────────────────
# Gmail: host smtp.gmail.com, port 587, user = your Gmail address,
# pass = a 16-character App Password (Google Account → Security → 2-Step
# Verification must be on → App passwords). Never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional. Leave unset: port 465 uses TLS from the start, 587 upgrades via STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# The From address. With Gmail it must be your Gmail address (or a verified alias).
EMAIL_FROM=
EMAIL_FROM_NAME=Teach for a Cause

# ── Brevo transactional email (only read when EMAIL_PROVIDER=brevo) ────────────
# Brevo → SMTP & API → API Keys
BREVO_API_KEY=
# Must be a sender you have verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Teach for a Cause

# ── Cron / worker protection ──────────────────────────────────────────────────
# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Sent by Supabase pg_cron (every 2 min: email, hourly: safety scan). Must equal
# the Vault secret "tfac_cron_secret" in the database. See docs/SETUP.md §5.
SUPABASE_CRON_SECRET=

# ── Admin console (/admin) ─────────────────────────────────────────────────────
# Nothing to set. Admins are normal accounts with role "admin" that sign in
# with their password plus an authenticator-app code (set up on first sign-in).
# See docs/SETUP.md for making the first admin and for a lost authenticator.
# (The old shared ADMIN_PASSWORD is gone; delete it from Vercel.)

# ── Phone / desktop notifications (optional) ──────────────────────────────────
# Leave empty to turn notifications off (everything is still emailed).
# Generate once with:  npx web-push generate-vapid-keys
# Keep the same pair forever: changing it silently unsubscribes every device.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SECRET.
VAPID_PRIVATE_KEY=
# Contact for the push services, e.g. mailto:team@yourdomain.org
VAPID_SUBJECT=
