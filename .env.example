# ── Supabase (Project Settings → API) ─────────────────────────────────────────
# These two are public by design (they ship to the browser). Row-level security
# in the database is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://nkpdiglnyqgblqcqvbdp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ccii317AbhJ8WyokT9V5Cg_S8_khA3N

# SECRET. Server-only. Used ONLY by the email worker to read the outbox.
# Supabase → Project Settings → API Keys → "service_role" / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# The public URL of the site (no trailing slash). Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in the footer and legal pages as the program's contact address.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Brevo transactional email (Brevo → SMTP & API → API Keys) ─────────────────
BREVO_API_KEY=
# Must be a sender you have verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Teach for a Cause

# ── Cron / worker protection ──────────────────────────────────────────────────
# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
